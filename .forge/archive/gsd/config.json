{
  "model_profile": "balanced",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "tavily_search": false,
  "ref_search": false,
  "perplexity": false,
  "jina": false,
  "git": {
    "branching_strategy": "none",
    "create_tag": true,
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": "gsd/quick-{num}-{slug}"
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": true,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "human_verify_mode": "end-of-phase",
    "context_guard_mode": "warn",
    "text_mode": false,
    "research_before_questions": true,
    "discuss_mode": "comprehensive",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "deep",
    "code_review_command": null,
    "pattern_mapper": true,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "auto_prune_state": false,
    "post_planning_gaps": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "tdd_mode": true,
    "ui_review": true,
    "_auto_chain_active": false,
    "use_worktrees": true
  },
  "ship": {
    "pr_body_sections": [
      {
        "heading": "Goal",
        "enabled": true,
        "source": "PLAN.md ## Objective || ROADMAP.md ## Phase Goal",
        "fallback": "- See the linked plan for this phase's goal."
      },
      {
        "heading": "Verification Verdict",
        "enabled": true,
        "source": "VERIFICATION.md ## Verdict",
        "fallback": "- Verification verdict recorded in VERIFICATION.md."
      },
      {
        "heading": "Human-Window Outcome",
        "enabled": true,
        "source": "*-HUMAN-WINDOW.md",
        "fallback": "- No human-contact window for this phase."
      },
      {
        "heading": "Telemetry Comparison",
        "enabled": true,
        "source": "eval/scorecards/harness/*-comparison.md",
        "fallback": "- No telemetry comparison recorded for this phase."
      },
      {
        "heading": "Deferred Items",
        "enabled": true,
        "source": ".planning/todos/pending/",
        "fallback": "- No deferred items with fingerprints for this phase."
      },
      {
        "heading": "Pending Operator Steps",
        "enabled": true,
        "source": "*-HUMAN-WINDOW.md ## Non-blocking",
        "fallback": "- No pending operator steps."
      }
    ]
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {
    "gsd-planner": [
      "global:test-posture",
      ".claude/skills/operator-steps",
      ".claude/skills/threat-model-declaration"
    ],
    "gsd-plan-checker": [
      "global:test-posture",
      ".claude/skills/operator-steps",
      ".claude/skills/threat-model-declaration"
    ],
    "gsd-verifier": [
      ".claude/skills/gap-verification"
    ]
  },
  "claude_md_path": "./.claude/CLAUDE.md",
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "mode": "yolo",
  "granularity": "comprehensive",
  "review": {
    "models": {
      "codex": "codex exec -m gpt-5.5"
    }
  },
  "intel": {
    "enabled": true
  },
  "graphify": {
    "enabled": true
  },
  "model_overrides": {
    "gsd-planner": "opus",
    "gsd-executor": "opus",
    "gsd-debugger": "opus",
    "gsd-code-reviewer": "opus",
    "gsd-phase-researcher": "opus",
    "gsd-project-researcher": "opus",
    "gsd-verifier": "opus",
    "gsd-plan-checker": "opus",
    "gsd-integration-checker": "opus",
    "gsd-codebase-mapper": "sonnet",
    "gsd-doc-writer": "sonnet",
    "planner": "opus",
    "executor": "opus",
    "verifier": "opus",
    "plan-checker": "opus",
    "reviewer": "opus",
    "researcher": "opus",
    "debugger": "opus",
    "mapper": "sonnet",
    "doc-writer": "sonnet",
    "gsd-roadmapper": "opus",
    "gsd-code-fixer": "opus",
    "gsd-security-auditor": "opus",
    "gsd-nyquist-auditor": "opus",
    "gsd-ui-researcher": "opus",
    "gsd-ui-checker": "opus",
    "gsd-ui-auditor": "opus",
    "gsd-advisor-researcher": "opus",
    "gsd-ai-researcher": "opus",
    "gsd-assumptions-analyzer": "opus",
    "gsd-debug-session-manager": "opus",
    "gsd-domain-researcher": "opus",
    "gsd-eval-auditor": "opus",
    "gsd-eval-planner": "opus",
    "gsd-framework-selector": "opus",
    "gsd-user-profiler": "opus",
    "gsd-research-synthesizer": "sonnet",
    "gsd-doc-verifier": "sonnet",
    "gsd-doc-classifier": "sonnet",
    "gsd-doc-synthesizer": "sonnet",
    "gsd-pattern-mapper": "sonnet",
    "gsd-intel-updater": "sonnet",
    "gsd-mempalace-curator": "sonnet"
  },
  "resolve_model_ids": "omit",
  "merge_policy": "never",
  "fast_mode": {
    "enabled": false
  },
  "autonomous": {
    "mode": "interactive",
    "scope": "next-phase",
    "dispatch_model": "opus",
    "runner_models": {
      "plan": "opus",
      "execute": "opus",
      "verify": "opus",
      "review": "opus",
      "ship": "opus"
    },
    "pr_stacking": true
  },
  "workstreams": {
    "enabled": false
  }
}
