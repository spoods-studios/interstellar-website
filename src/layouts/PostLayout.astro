---
// Shared reading layout for the content trees (UI-SPEC "Layout factoring")
// -- each route passes its own meta/breadcrumbs/TOC props to this same layout
// rather than re-deriving the shell.
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { MarkdownHeading } from '../lib/toc';

export interface LinkRef {
  href: string;
  label: string;
}

export interface Props {
  title: string;
  meta?: string;
  headings?: MarkdownHeading[];
  breadcrumbs?: LinkRef[];
  backLink?: LinkRef;
  description?: string;
  ogType?: 'article' | 'website';
  ogImage?: { src: string; width: number; height: number; alt: string };
  publishedTime?: string;
}

// The four metadata props are a pure pass-through -- PostLayout adds no logic
// of its own, it just lets every route rendering through it supply metadata.
const {
  title,
  meta,
  headings,
  breadcrumbs,
  backLink,
  description,
  ogType,
  ogImage,
  publishedTime,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogType={ogType}
  ogImage={ogImage}
  publishedTime={publishedTime}
>
  {breadcrumbs && breadcrumbs.length > 0 && (
    <nav class="breadcrumbs">
      {breadcrumbs.map((b) => <a href={b.href}>{b.label}</a>)}
    </nav>
  )}
  {meta && <p class="meta">{meta}</p>}
  {headings && <TableOfContents headings={headings} />}
  <slot />
  {backLink && (
    <nav class="post-nav">
      <a href={backLink.href}>{backLink.label}</a>
    </nav>
  )}
</BaseLayout>
