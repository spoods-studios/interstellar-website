---
import BaseLayout from '../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const notFoundCopy = 'No page exists at this address. The link is out of date or mistyped.';
---

<BaseLayout title="Page not found" description={notFoundCopy}>
  <p class="label">HTTP 404</p>
  <h1>Page not found.</h1>
  <p>{notFoundCopy}</p>
  <p><a href={base}>Go to the home page</a></p>
</BaseLayout>
