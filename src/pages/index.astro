---
import { DISCORD_INVITE_URL, SITE_NAME, SITE_TAGLINE } from '../lib/site.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<BaseLayout title={SITE_NAME} description={SITE_TAGLINE}>
  <h1>{SITE_NAME}</h1>
  <p>{SITE_TAGLINE}</p>
  <p><a href={`${base}roadmap/`}>Roadmap</a></p>
  <p><a href={DISCORD_INVITE_URL} target="_blank" rel="noopener noreferrer">Join the Discord</a></p>
</BaseLayout>
