---
import { Picture, getImage } from 'astro:assets';
import { DISCORD_INVITE_URL, SITE_TAGLINE } from '../lib/site.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowcaseClip from '../components/ShowcaseClip.astro';
import captures from '../assets/showcase/captures.json';
import terminator from '../assets/showcase/terminator.png';
import buildupL0 from '../assets/showcase/buildup-l0.png';
import buildupL1 from '../assets/showcase/buildup-l1.png';
import buildupL2 from '../assets/showcase/buildup-l2.png';
import orbit from '../assets/showcase/orbit.png';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const roadmapHref = `${base}roadmap/`;

const still = {
  formats: ['avif', 'webp'],
  fallbackFormat: 'jpg',
  layout: 'constrained',
  width: 1280,
  height: 720,
  widths: [640, 1280, 1920],
  quality: 'mid',
} as const;

const bend = '<svg class="bend" width="100%" height="100" viewBox="0 0 100 100" preserveAspectRatio="none" overflow="visible"><path d="M100 0 C100 50 0 50 0 100" /></svg><line x1="0" y1="100" x2="0" y2="100%" />';
const end = `${bend}<circle cx="0" cy="100%" r="5" />`;

const captured = (name: keyof typeof captures) => `Captured ${captures[name].captured}.`;

const og = await getImage({ src: terminator, format: 'jpg', width: 1280, height: 720 });
const ogImage = {
  src: og.src,
  width: Number(og.attributes.width),
  height: Number(og.attributes.height),
  alt: "Earth's limb at the terminator from low orbit, a frame from the current build of Setare Aerospace.",
};
---

<BaseLayout title="Setare Aerospace" description={SITE_TAGLINE} ogImage={ogImage}>
  <svg class="traj-live" aria-hidden="true" preserveAspectRatio="none"><path pathLength="1" /><circle r="5" /></svg>

  <section class="hero">
    <svg class="traj" aria-hidden="true"><line x1="100%" y1="0" x2="100%" y2="100%" /></svg>
    <h1 class="enter">Setare Aerospace</h1>
    <p class="lede enter">A space-flight game on Interstellar Engine, a C++20 and Vulkan 1.3 engine. Orbits integrate under N-body gravity with J2 oblateness and relativistic precession; positions store as int64 millimetres. Every image on this page is a frame from the current build.</p>
    <div class="act enter">
      <a class="cta" href={DISCORD_INVITE_URL} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h14M13 6l6 6-6 6" /></svg>Join the Discord</a>
      <a href={roadmapHref}>Roadmap</a>
    </div>
    <figure class="fig1 enter">
      <div class="plate">
        <Picture {...still} src={terminator} priority sizes="(min-width: 860px) 75vw, 100vw" alt="Earth's limb at the terminator from low orbit, blue atmosphere fading to night" />
      </div>
      <figcaption><b>Fig. 1</b>Earth terminator from low orbit. Aerial perspective on. {captured('terminator')}</figcaption>
    </figure>
    <aside class="margin enter">
      <span class="label">Vis-viva</span>
      <div class="eq">v² = μ (2/r − 1/a)</div>
      <p>The integrator is Wisdom-Holman, nested for satellites. Planet positions are checked against JPL HORIZONS.</p>
    </aside>
  </section>

  <section class="ch">
    <svg class="traj" aria-hidden="true" set:html={bend} />
    <header><span class="label num">Chapter 2</span><h2 class="enter">Layer buildup</h2></header>
    <p class="body enter">One 10 s descent from 400 km to the surface, rendered with four layer presets. The four passes run on a fixed 60 Hz tick and match frame for frame.</p>
    <div class="row4">
      <figure class="enter">
        <div class="plate"><Picture {...still} src={buildupL0} sizes="(min-width: 860px) 25vw, 50vw" alt="Earth from orbit with the cube-sphere wireframe drawn over terrain and ocean" /></div>
        <figcaption><b>2.1</b>Wireframe cube-sphere. {captured('buildup-l0')}</figcaption>
      </figure>
      <figure class="enter">
        <div class="plate"><Picture {...still} src={buildupL1} sizes="(min-width: 860px) 25vw, 50vw" alt="The same view with each terrain tile tinted by its level of detail" /></div>
        <figcaption><b>2.2</b>LOD tint. {captured('buildup-l1')}</figcaption>
      </figure>
      <figure class="enter">
        <div class="plate"><Picture {...still} src={buildupL2} sizes="(min-width: 860px) 25vw, 50vw" alt="The same view with terrain colour on land and ocean" /></div>
        <figcaption><b>2.3</b>Terrain. {captured('buildup-l2')}</figcaption>
      </figure>
      <ShowcaseClip class="enter" name="buildup-l4" number="2.4" caption="Aerial perspective and ocean mask shading." />
    </div>
  </section>

  <section class="ch">
    <svg class="traj flip" aria-hidden="true" set:html={bend} />
    <header><span class="label num">Chapter 3</span><h2 class="enter">Launch-site terrain</h2></header>
    <p class="body enter">Kennedy Space Center, Starbase and Vandenberg load dataset-backed elevation and land cover. Each clip is the first 6 s of a descent from 12 km to 6 km, looking down at 28.6°.</p>
    <div class="row3">
      <ShowcaseClip class="enter" name="spot-ksc" number="3.1" caption="Kennedy Space Center, Florida." />
      <ShowcaseClip class="enter" name="spot-starbase" number="3.2" caption="Starbase, Texas." />
      <ShowcaseClip class="enter" name="spot-vandenberg" number="3.3" caption="Vandenberg, California." />
    </div>
  </section>

  <section class="ch">
    <svg class="traj" aria-hidden="true" set:html={bend} />
    <header><span class="label num">Chapter 4</span><h2 class="enter">Lighting</h2></header>
    <p class="body enter">Atmospheric scattering is computed from the sun direction each frame. The lighting plates fix the sun at five elevations over Kennedy Space Center; every other capture uses the real sun position for its date.</p>
    <div class="split">
      <figure class="enter">
        <div class="plate"><Picture {...still} src={orbit} sizes="(min-width: 860px) 58vw, 100vw" alt="Earth's horizon from orbit, the atmosphere fading from blue to black" /></div>
        <figcaption><b>4.1</b>Earth from orbit. {captured('orbit')}</figcaption>
      </figure>
      <figure class="enter">
        <div class="diagram" role="img" aria-label="Five sun elevations used for the lighting plates: noon 90 degrees, raking 8 degrees, terminator 0 degrees, sunrise limb minus 2 degrees and night minus 25 degrees">
          <svg viewBox="0 0 400 340" aria-hidden="true">
            <path d="M20 180 H380" stroke="currentColor" stroke-width="1.5" />
            <circle cx="200" cy="180" r="150" fill="none" stroke="currentColor" stroke-dasharray="4 5" />
            <g fill="currentColor">
              <circle cx="200" cy="30" r="5" />
              <circle cx="51.5" cy="159.1" r="5" />
              <circle cx="50" cy="180" r="5" />
              <circle cx="349.9" cy="185.2" r="5" />
            </g>
            <circle cx="64.1" cy="243.4" r="5" fill="none" stroke="currentColor" />
            <text x="212" y="34">Noon 90°</text>
            <text x="64" y="152">Raking 8°</text>
            <text x="62" y="202">Terminator 0°</text>
            <text x="200" y="208">Sunrise limb −2°</text>
            <text x="78" y="248">Night −25°</text>
          </svg>
        </div>
        <figcaption><b>4.2</b>Sun elevations captured for the lighting plates.</figcaption>
      </figure>
    </div>
  </section>

  <section class="ch">
    <svg class="traj flip" aria-hidden="true" set:html={bend} />
    <header><span class="label num">Chapter 5</span><h2 class="enter">Orbital mechanics</h2></header>
    <p class="body enter">Every body and craft integrates under the same force model. Mercury's perihelion advances 42.98″ per century from the relativistic term. Maneuver nodes predict the trajectory with the same physics the flight uses, so the predicted line and the flown line match.</p>
    <div class="split">
      <div class="diagram enter" role="img" aria-label="Elliptical orbit with the central body at one focus, periapsis, apoapsis and a prograde burn at periapsis">
        <svg viewBox="0 0 560 340" aria-hidden="true">
          <ellipse cx="280" cy="170" rx="220" ry="150" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M60 170 H500" stroke="currentColor" stroke-dasharray="3 5" />
          <circle cx="119" cy="170" r="14" fill="currentColor" />
          <circle cx="60" cy="170" r="4" fill="currentColor" />
          <circle cx="500" cy="170" r="4" fill="currentColor" />
          <path class="burn" d="M60 170 V126 M54 136 L60 124 L66 136" fill="none" stroke-width="2.5" />
          <text x="14" y="200">Periapsis</text>
          <text x="440" y="200">Apoapsis</text>
          <text x="100" y="212">Focus</text>
          <text class="dv" x="70" y="134">Δv</text>
        </svg>
      </div>
      <aside class="margin enter">
        <span class="label">Kepler's equation</span>
        <div class="eq">M = E − e sin E</div>
        <p>The Kepler solver runs to a fixed accuracy, so time warp gives the same positions as 1× flight.</p>
      </aside>
    </div>
  </section>

  <section class="ch">
    <svg class="traj" aria-hidden="true" set:html={bend} />
    <header><span class="label num">Planned</span><h2 class="enter">Next milestones</h2></header>
    <p class="body enter">The current build renders Earth. These milestones are planned.</p>
    <div class="ghosts">
      <div class="ghost enter"><svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-dasharray="4 4" aria-hidden="true"><circle cx="50" cy="50" r="40" /></svg><div><span class="label prep">In preparation</span><b class="label">The Moon and Mars</b>Surfaces from measured elevation data.</div></div>
      <div class="ghost enter"><svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-dasharray="4 4" aria-hidden="true"><path d="M20 70 Q50 10 80 70" /><circle cx="20" cy="70" r="4" /><circle cx="80" cy="70" r="4" /></svg><div><span class="label prep">In preparation</span><b class="label">Flight plans</b>Multi-burn plans and automatic burn execution.</div></div>
      <div class="ghost enter"><svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-dasharray="4 4" aria-hidden="true"><circle cx="50" cy="50" r="30" /><ellipse cx="50" cy="50" rx="46" ry="12" /></svg><div><span class="label prep">In preparation</span><b class="label">Gas giants</b>Jupiter, Saturn and their moons.</div></div>
      <div class="ghost enter"><svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-dasharray="4 4" aria-hidden="true"><path d="M10 80 L50 20 L90 80 Z" /></svg><div><span class="label prep">In preparation</span><b class="label">Living ground</b>Vegetation and shadows at the launch sites.</div></div>
    </div>
    <p class="more enter"><a href={roadmapHref}>Roadmap</a></p>
  </section>

  <section class="close">
    <svg class="traj flip" aria-hidden="true" set:html={end} />
    <h2 class="enter">Discord</h2>
    <p class="enter">Captures from each milestone post to the Discord when it ships.</p>
    <a class="cta enter" href={DISCORD_INVITE_URL} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h14M13 6l6 6-6 6" /></svg>Join the Discord</a>
  </section>

  <script>
    import { setupClipPlay } from '../scripts/clip-play';
    import { initShowcaseMotion } from '../scripts/showcase-motion';
    setupClipPlay([...document.querySelectorAll('video')], {
      IntersectionObserver,
      matchMedia,
      saveData: (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true,
    });
    initShowcaseMotion();
  </script>
</BaseLayout>

<style is:global>
  :where(.page > section, .page > section *) {
    margin: 0;
  }

  .page {
    position: relative;
  }

  .page > section {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: start;
    position: relative;
    --dir: 1;
  }

  .page > section:nth-of-type(even) {
    --dir: -1;
  }

  .page > section > * {
    position: relative;
    z-index: 1;
  }

  .page > section > .traj {
    position: absolute;
    z-index: 0;
    top: 0;
    left: calc(var(--gut) / -2);
    width: calc(100% + var(--gut));
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .traj.flip {
    transform: scaleX(-1);
  }

  .traj path,
  .traj line {
    fill: none;
    stroke: var(--verm);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .traj circle,
  .traj-live circle {
    fill: var(--verm);
  }

  .page > .traj-live {
    display: none;
    position: absolute;
    z-index: 0;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .traj-live path {
    fill: none;
    stroke: var(--verm);
    stroke-width: 2;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .page > .traj-live {
      display: block;
    }

    .js .page > section > .traj {
      display: none;
    }

    .js .traj-live path {
      stroke-dasharray: 1 1;
      stroke-dashoffset: 1;
    }

    .js .enter {
      opacity: 0;
      transform: translate(calc(var(--dir) * -28px), -18px) rotate(calc(var(--dir) * -1.2deg));
      filter: blur(4px);
      transition: opacity .9s var(--ease), transform 1.1s var(--ease), filter .9s var(--ease);
    }

    .js .enter.in {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  .page > section p {
    text-wrap: pretty;
  }

  .hero h1 {
    grid-column: 1 / 10;
  }

  .hero .lede {
    grid-column: 1 / 8;
    margin-top: 22px;
    font-weight: 600;
  }

  .hero .act {
    grid-column: 1 / 13;
    margin-top: 28px;
    display: flex;
    gap: 28px;
    align-items: center;
    flex-wrap: wrap;
  }

  .plate {
    position: relative;
    background: var(--plate);
    border: 1px solid var(--ink);
    padding: 10px;
  }

  .plate picture {
    display: block;
  }

  .plate img,
  .plate video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .plate .clip {
    position: absolute;
    right: 20px;
    top: 20px;
    display: flex;
    gap: 6px;
    align-items: center;
    color: #fff;
    background: rgba(13, 22, 38, .7);
    padding: 4px 8px;
  }

  .plate .clip svg {
    width: 14px;
    height: 14px;
  }

  .page > section figcaption {
    margin-top: 12px;
    color: var(--ink-soft);
  }

  .page > section figcaption b {
    color: var(--ink);
    font: 700 var(--s)/1.3 Archivo, sans-serif;
    font-stretch: 88%;
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-right: 8px;
  }

  .fig1 {
    grid-column: 1 / 10;
    margin-top: 48px;
  }

  .margin {
    grid-column: 10 / 13;
    margin-top: 48px;
    border-top: 2px solid var(--ink);
    padding-top: 12px;
  }

  .margin .eq {
    font: italic 400 var(--s)/1.5 "Source Serif 4", Georgia, serif;
    margin: 10px 0;
    white-space: nowrap;
  }

  .margin p {
    color: var(--ink-soft);
  }

  .page > section.ch {
    padding-top: 140px;
  }

  .ch header {
    grid-column: 1 / 13;
    display: grid;
    grid-template-columns: subgrid;
    align-items: end;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 18px;
  }

  .ch header .num {
    grid-column: 1 / 3;
    color: var(--verm-ink);
  }

  .ch header h2 {
    grid-column: 3 / 13;
  }

  .ch h2,
  .close h2 {
    font: 850 var(--l)/.92 Archivo, sans-serif;
    font-stretch: 72%;
    letter-spacing: -.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .ch .body {
    grid-column: 3 / 9;
    margin-top: 24px;
  }

  .row4,
  .row3,
  .split,
  .ghosts {
    grid-column: 1 / 13;
    display: grid;
    gap: 24px;
    margin-top: 40px;
  }

  .row4,
  .ghosts {
    grid-template-columns: repeat(4, 1fr);
  }

  .row3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .split {
    grid-template-columns: 7fr 5fr;
    align-items: start;
  }

  .split .margin {
    margin-top: 0;
  }

  .diagram {
    border: 1px solid var(--ink);
    padding: 16px;
    background: rgba(255, 255, 255, .35);
    color: var(--ink);
  }

  .diagram svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram text {
    font: 600 13px Archivo, sans-serif;
    fill: var(--ink);
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .diagram .burn {
    stroke: var(--verm);
  }

  .diagram .dv {
    fill: var(--verm-ink);
  }

  .ghost {
    border: 1.5px dashed var(--ink-soft);
    padding: 20px;
    min-height: 240px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--ink-soft);
  }

  .ghost svg {
    width: 96px;
    height: 96px;
  }

  .ghost .prep {
    display: block;
    color: var(--verm-ink);
  }

  .ghost b {
    display: block;
    color: var(--ink);
  }

  .more {
    grid-column: 3 / 13;
    margin-top: 28px;
  }

  .page > section.close {
    padding-top: 180px;
  }

  .close h2 {
    grid-column: 1 / 11;
  }

  .close p {
    grid-column: 1 / 8;
    margin: 22px 0 30px;
  }

  .close .cta {
    grid-column: 1 / 5;
    justify-self: start;
  }

  @media (max-width: 860px) {
    .hero h1,
    .hero .lede,
    .fig1,
    .margin,
    .ch .body,
    .more,
    .close h2,
    .close p,
    .ch header .num,
    .ch header h2 {
      grid-column: 1 / 13;
    }

    .row4,
    .ghosts {
      grid-template-columns: repeat(2, 1fr);
    }

    .row3,
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
